# Vite uses the same-origin FastAPI proxy in dev and preview.
PETEY_BACKEND_URL=http://127.0.0.1:8000
# Set a public API origin here if the browser should connect to FastAPI directly.
VITE_API_URL=

# Google Maps Platform API key for live Weather API conditions
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
